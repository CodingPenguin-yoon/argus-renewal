# Argus Renewal backend
# Copy this file to backend/.env and fill only the credentials you own.
# Never commit backend/.env or issued access tokens.

# Runtime
FRONTEND_ORIGIN=http://localhost:3000
DB_PATH=data/argus.db

# Market-data mode
# Keep mock until a live adapter is enabled. Mock mode requires no API key.
MARKET_DATA_MODE=mock
MARKET_FLOW_ESTIMATE_STALE_AFTER_SECONDS=300
MARKET_FLOW_CONFIRMED_STALE_AFTER_SECONDS=604800

# Korea Investment & Securities Open API
# App key/secret are used to issue an access token at runtime.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_TOKEN_PATH=/oauth2/tokenP
KIS_TOKEN_CACHE_PATH=data/kis_token_cache.json
KIS_APP_KEY=
KIS_APP_SECRET=

