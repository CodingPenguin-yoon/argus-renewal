# frontend
BACKEND_BASE_URL=http://localhost:4000

# backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEWS_PROVIDER=mock
DB_PATH=data/argus.db

# DART company master
DART_SYNC_ENABLED=false
DART_API_KEY=
DART_CORP_CODE_URL=https://opendart.fss.or.kr/api/corpCode.xml
DART_DISCLOSURE_LIST_URL=https://opendart.fss.or.kr/api/list.json
DART_DISCLOSURE_PAGE_COUNT=100
DART_MATERIAL_ONLY=true
DART_MATERIAL_INCLUDE_PATTERNS=
DART_MATERIAL_EXCLUDE_PATTERNS=

# KIS company master
KIS_MASTER_PROVIDER=disabled
KIS_MASTER_FILE_PATH=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_SYMBOL_MASTER_PATH=/uapi/domestic-stock/v1/quotations/search-stock-info
KIS_SYMBOL_MASTER_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KIS_SYMBOL_MASTER_QUERY_PARAMS_JSON=
KIS_SYMBOL_MASTER_TR_ID=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCESS_TOKEN=

# market briefing collectors common
MARKET_BRIEFING_TIMEOUT_SECONDS=20
MARKET_BRIEFING_MAX_RETRIES=3
MARKET_BRIEFING_BACKOFF_SECONDS=1.0
MARKET_BRIEFING_SIGNAL_ENABLED=true
MARKET_BRIEFING_SIGNAL_MARKET_SCOPE=KRX
MARKET_BRIEFING_SIGNAL_RULES_JSON=

# KIS market breadth (investor flow/program trading/credit balance)
KIS_MARKET_BREADTH_PROVIDER=disabled
KIS_MARKET_BREADTH_FILE_PATH=
KIS_MARKET_BREADTH_PATH=/uapi/domestic-stock/v1/market/market-breadth
KIS_MARKET_BREADTH_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KIS_MARKET_BREADTH_QUERY_PARAMS_JSON=
KIS_MARKET_BREADTH_FIELD_ALIAS_MAP_JSON=
KIS_MARKET_BREADTH_TR_ID=

# KIS domestic derivatives pre-open snapshots
KIS_DOMESTIC_DERIVATIVES_PROVIDER=disabled
KIS_DOMESTIC_DERIVATIVES_FILE_PATH=
KIS_DOMESTIC_DERIVATIVES_PATH=/uapi/domestic-futureoption/v1/quotations/inquire-price
KIS_DOMESTIC_DERIVATIVES_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KIS_DOMESTIC_DERIVATIVES_QUERY_PARAMS_JSON=
KIS_DOMESTIC_DERIVATIVES_FIELD_ALIAS_MAP_JSON=
KIS_DOMESTIC_DERIVATIVES_TR_ID=

# KIS night futures snapshots
KIS_NIGHT_FUTURES_PROVIDER=disabled
KIS_NIGHT_FUTURES_FILE_PATH=
KIS_NIGHT_FUTURES_PATH=/uapi/overseas-futureoption/v1/quotations/night-futures
KIS_NIGHT_FUTURES_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KIS_NIGHT_FUTURES_QUERY_PARAMS_JSON=
KIS_NIGHT_FUTURES_FIELD_ALIAS_MAP_JSON=
KIS_NIGHT_FUTURES_TR_ID=

# KRX derivatives reference (put/call ratio, implied volatility, investor performance)
KRX_DERIVATIVES_REFERENCE_PROVIDER=disabled
KRX_DERIVATIVES_REFERENCE_FILE_PATH=
KRX_DERIVATIVES_REFERENCE_BASE_URL=https://data.krx.co.kr
KRX_DERIVATIVES_REFERENCE_PATH=/api/derivatives/reference
KRX_DERIVATIVES_REFERENCE_API_KEY=
KRX_DERIVATIVES_REFERENCE_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KRX_DERIVATIVES_REFERENCE_QUERY_PARAMS_JSON=
KRX_DERIVATIVES_REFERENCE_FIELD_ALIAS_MAP_JSON=

# raw source ingestion common
RAW_INGESTION_TIMEOUT_SECONDS=20
RAW_INGESTION_MAX_RETRIES=3
RAW_INGESTION_BACKOFF_SECONDS=1.0
RAW_INGESTION_DESCRIPTOR_FACTORY_PATHS=

# MK RSS ingestion
MK_RSS_ENABLED=false
MK_RSS_FEED_URLS=https://www.mk.co.kr/rss/30100041/,https://www.mk.co.kr/rss/50200011/

# Naver news ingestion
NAVER_NEWS_ENABLED=false
NAVER_NEWS_BASE_URL=https://openapi.naver.com
NAVER_NEWS_SEARCH_PATH=/v1/search/news.json
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NAVER_NEWS_DISPLAY=50
NAVER_NEWS_PAGE_LIMIT=5
NAVER_NEWS_COMPANY_QUERY_TEMPLATE={company_name} 주가 OR 공시
NAVER_NEWS_THEME_QUERY_TEMPLATE={keyword} 증시

# Naver Datalab attention signal
NAVER_DATALAB_ENABLED=false
NAVER_DATALAB_BASE_URL=https://openapi.naver.com
NAVER_DATALAB_SEARCH_PATH=/v1/datalab/search
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=
NAVER_DATALAB_TIME_UNIT=date

# raw source ingestion scheduled batch defaults
RAW_INGESTION_SCHEDULE_DAYS=1
RAW_INGESTION_SCHEDULE_INCLUDE_DART=true
RAW_INGESTION_SCHEDULE_INCLUDE_COMPANY_NEWS=true
RAW_INGESTION_SCHEDULE_INCLUDE_THEME_NEWS=true
RAW_INGESTION_SCHEDULE_DISCLOSURE_PROVIDERS=
RAW_INGESTION_SCHEDULE_COMPANY_NEWS_PROVIDERS=
RAW_INGESTION_SCHEDULE_THEME_NEWS_PROVIDERS=
RAW_INGESTION_SCHEDULE_COMPANY_IDS=
RAW_INGESTION_SCHEDULE_COMPANY_NAMES=
RAW_INGESTION_SCHEDULE_THEME_KEYWORDS=

# normalized event pipeline
EVENT_PIPELINE_ENABLED=true
EVENT_PIPELINE_BATCH_SIZE=200
EVENT_PIPELINE_LOW_CONFIDENCE_THRESHOLD=0.55
EVENT_PIPELINE_INCLUDE_LLM=true

# normalized event pipeline LLM extractor
EVENT_PIPELINE_LLM_ENABLED=false
EVENT_PIPELINE_LLM_PROVIDER=disabled
EVENT_PIPELINE_LLM_BASE_URL=
EVENT_PIPELINE_LLM_API_KEY=
EVENT_PIPELINE_LLM_MODEL=
EVENT_PIPELINE_LLM_TIMEOUT_SECONDS=20
EVENT_PIPELINE_LLM_MAX_RETRIES=2
EVENT_PIPELINE_LLM_BACKOFF_SECONDS=1.0

# nightly company report pipeline (KRX large-cap universe)
COMPANY_REPORT_PIPELINE_ENABLED=true
COMPANY_REPORT_MARKET_SCOPE=KRX
COMPANY_REPORT_UNIVERSE_KEY=KRX_LARGE_CAP_CORE
COMPANY_REPORT_UNIVERSE_NAME=KRX Large Cap Core
COMPANY_REPORT_UNIVERSE_TARGET_SIZE=25
COMPANY_REPORT_SEED_STOCK_CODES=005930,000660,035420,005380,012330,051910,006400,068270,105560,055550,207940,035720,000270,028260,096770,066570,015760,017670,009540,003550
COMPANY_REPORT_EVENT_LOOKBACK_DAYS=7
COMPANY_REPORT_DISCLOSURE_LOOKBACK_DAYS=14
COMPANY_REPORT_PRICE_LOOKBACK_DAYS=7

# company report LLM narrative generator (optional)
COMPANY_REPORT_LLM_ENABLED=false
COMPANY_REPORT_LLM_PROVIDER=disabled
COMPANY_REPORT_LLM_BASE_URL=
COMPANY_REPORT_LLM_API_KEY=
COMPANY_REPORT_LLM_MODEL=
COMPANY_REPORT_LLM_TIMEOUT_SECONDS=20
COMPANY_REPORT_LLM_MAX_RETRIES=2
COMPANY_REPORT_LLM_BACKOFF_SECONDS=1.0

# news tab product materialization
NEWS_PRODUCT_LOOKBACK_DAYS=7
NEWS_PRODUCT_CARD_LIMIT=12
NEWS_PRODUCT_REPRESENTATIVE_EVIDENCE_LIMIT=3
NEWS_PRODUCT_REFRESH_TTL_SECONDS=300
NEWS_PRODUCT_DATALAB_WINDOW_DAYS=7
NEWS_PRODUCT_EDITORIAL_AI_ENABLED=false
NEWS_PRODUCT_EDITORIAL_AI_PROVIDER=disabled
NEWS_PRODUCT_EDITORIAL_AI_BASE_URL=
NEWS_PRODUCT_EDITORIAL_AI_API_KEY=
NEWS_PRODUCT_EDITORIAL_AI_MODEL=
NEWS_PRODUCT_EDITORIAL_AI_TIMEOUT_SECONDS=20
NEWS_PRODUCT_EDITORIAL_AI_MAX_RETRIES=2
NEWS_PRODUCT_EDITORIAL_AI_BACKOFF_SECONDS=1.0
NEWS_PRODUCT_EDITORIAL_AI_CANDIDATE_LIMIT=8
NEWS_PRODUCT_EDITORIAL_AI_MIN_EDITORIAL_SCORE=0.55

# global events sync
GLOBAL_EVENTS_SYNC_ENABLED=true
GLOBAL_EVENTS_SCHEDULE_LOOKBACK_DAYS=7
GLOBAL_EVENTS_SCHEDULE_LOOKAHEAD_DAYS=21
GLOBAL_EVENTS_RELEASE_LOOKBACK_DAYS=120
GLOBAL_EVENTS_TIMEOUT_SECONDS=20
GLOBAL_EVENTS_MAX_RETRIES=3
GLOBAL_EVENTS_BACKOFF_SECONDS=1.0

# official global events sources
GLOBAL_EVENTS_FED_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm
GLOBAL_EVENTS_BLS_CALENDAR_URL=https://www.bls.gov/schedule/news_release/bls.ics
GLOBAL_EVENTS_BLS_API_URL=https://api.bls.gov/publicAPI/v2/timeseries/data/
GLOBAL_EVENTS_BEA_SCHEDULE_URL=https://www.bea.gov/news/schedule
GLOBAL_EVENTS_BEA_PCE_URL=https://www.bea.gov/data/personal-consumption-expenditures-price-index
GLOBAL_EVENTS_BEA_API_URL=https://apps.bea.gov/api/data
GLOBAL_EVENTS_BEA_API_KEY=
GLOBAL_EVENTS_ECB_CALENDAR_URL=https://www.ecb.europa.eu/press/calendars/mgcgc/html/index.en.html
GLOBAL_EVENTS_BOJ_CALENDAR_URL=https://www.boj.or.jp/en/mopo/mpmsche_minu/index.htm

# optional vendor adapter (forecasts / importance / big-tech earnings)
GLOBAL_EVENTS_VENDOR_PROVIDER=disabled
GLOBAL_EVENTS_VENDOR_FILE_PATH=
GLOBAL_EVENTS_VENDOR_BASE_URL=
GLOBAL_EVENTS_VENDOR_SCHEDULE_PATH=
GLOBAL_EVENTS_VENDOR_API_KEY=
GLOBAL_EVENTS_VENDOR_REQUIRED=false

# optional LLM impact summaries
GLOBAL_EVENTS_LLM_ENABLED=false
GLOBAL_EVENTS_LLM_PROVIDER=disabled
GLOBAL_EVENTS_LLM_BASE_URL=
GLOBAL_EVENTS_LLM_API_KEY=
GLOBAL_EVENTS_LLM_MODEL=
GLOBAL_EVENTS_LLM_TIMEOUT_SECONDS=20
GLOBAL_EVENTS_LLM_MAX_RETRIES=2
GLOBAL_EVENTS_LLM_BACKOFF_SECONDS=1.0

# admin endpoint protection (optional, recommended for production)
KRX_ADMIN_API_KEY=
