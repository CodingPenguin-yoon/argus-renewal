# Argus v2 clean-room env example
# Copy backend values to backend/.env and frontend values to frontend/.env.local as needed.

# Frontend
BACKEND_BASE_URL=http://localhost:4000

# Backend runtime
FRONTEND_ORIGIN=http://localhost:3000
DB_PATH=data/argus.db

# KIS credentials required for live derivatives/option smoke tests.
# Access tokens are issued at runtime from app key/secret.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_TOKEN_PATH=/oauth2/tokenP
KIS_TOKEN_CACHE_PATH=data/kis_token_cache.json
KIS_APP_KEY=
KIS_APP_SECRET=

# KIS providers targeted by Argus v2 smoke validation
KIS_DOMESTIC_DERIVATIVES_PROVIDER=api
KIS_DOMESTIC_DERIVATIVES_PATH=/uapi/domestic-futureoption/v1/quotations/inquire-price
KIS_DOMESTIC_DERIVATIVES_RESPONSE_PATHS=output,output1,output2,items,data.items,data.rows,data
KIS_DOMESTIC_DERIVATIVES_QUERY_PARAMS_JSON={"FID_INPUT_ISCD":"AUTO_KOSPI200_FRONT"}
KIS_DOMESTIC_DERIVATIVES_FIELD_ALIAS_MAP_JSON=
KIS_DOMESTIC_DERIVATIVES_TR_ID=

KIS_OPTION_CHAIN_PROVIDER=api
KIS_OPTION_CHAIN_PATH=/uapi/domestic-futureoption/v1/quotations/display-board-callput
KIS_OPTION_CHAIN_RESPONSE_PATHS=option_levels,levels,items,output,output1,output2,data.items,data.rows,data
KIS_OPTION_CHAIN_QUERY_PARAMS_JSON=
KIS_OPTION_CHAIN_FIELD_ALIAS_MAP_JSON=
KIS_OPTION_CHAIN_TR_ID=FHPIF05030100
KIS_OPTION_CHAIN_EXPIRY_MONTH=
KIS_OPTION_LIST_PATH=/uapi/domestic-futureoption/v1/quotations/display-board-option-list
KIS_OPTION_LIST_RESPONSE_PATHS=output,data.items,data.rows,data
KIS_OPTION_LIST_QUERY_PARAMS_JSON=
KIS_OPTION_LIST_TR_ID=FHPIO056104C0
KIS_OPTION_CHAIN_EXPECTED_LEVEL_COUNT=0
KIS_OPTION_CHAIN_STALE_AFTER_SECONDS=300

# Argus v2 market reaction/news inputs.
# Use mock for local UI development, file for manual JSON imports, kis for KIS index/sector data.
ARGUS_MARKET_REACTION_PROVIDER=mock
ARGUS_MARKET_REACTION_FILE_PATH=
ARGUS_MARKET_REACTION_INDEX_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-index-price
ARGUS_MARKET_REACTION_INDEX_PRICE_TR_ID=FHPUP02100000
ARGUS_MARKET_REACTION_CATEGORY_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-index-category-price
ARGUS_MARKET_REACTION_CATEGORY_PRICE_TR_ID=FHPUP02140000
ARGUS_MARKET_REACTION_INVESTOR_TIME_PATH=/uapi/domestic-stock/v1/quotations/inquire-investor-time-by-market
ARGUS_MARKET_REACTION_INVESTOR_TIME_TR_ID=FHPTJ04030000
ARGUS_MARKET_REACTION_INVESTOR_AMOUNT_MULTIPLIER=10000
ARGUS_MARKET_REACTION_SECTOR_LIMIT=3

# Use mock for local no-key UI. Live RSS/Naver/DART only collect raw items;
# semantic news judgement is AI-enriched instead of keyword-classified.
ARGUS_NEWS_TRIGGERS_PROVIDER=mock
ARGUS_NEWS_TRIGGERS_FILE_PATH=
ARGUS_NEWS_TRIGGERS_RSS_URLS=https://www.mk.co.kr/rss/30100041/,https://www.mk.co.kr/rss/50200011/
ARGUS_NEWS_TRIGGERS_QUERY=금리,환율,반도체,코스피,선물,옵션
ARGUS_NEWS_TRIGGERS_LIMIT=3
ARGUS_NEWS_TRIGGERS_LOOKBACK_HOURS=24
# Set ARGUS_NEWS_AI_PROVIDER=gemini for Gemini, or openai for OpenAI-compatible chat completions.
ARGUS_NEWS_AI_PROVIDER=disabled
ARGUS_NEWS_AI_BASE_URL=https://api.openai.com
ARGUS_NEWS_AI_CHAT_PATH=/v1/chat/completions
ARGUS_NEWS_AI_MODEL=
ARGUS_NEWS_AI_API_KEY=
# Gemini shortcut aliases. These are used when ARGUS_NEWS_AI_MODEL/API_KEY are empty.
ARGUS_GEMINI_MODEL=gemini-2.5-flash
ARGUS_GEMINI_API_KEY=
# Common Gemini aliases are also supported if already present in a local env.
GEMINI_MODEL=
GEMINI_API_KEY=
ARGUS_NEWS_AI_TIMEOUT_SECONDS=8
ARGUS_MACRO_EVENTS_PROVIDER=disabled
ARGUS_MACRO_EVENTS_FILE_PATH=

# Optional v2 news/disclosure API keys.
ARGUS_NEWS_NAVER_CLIENT_ID=
ARGUS_NEWS_NAVER_CLIENT_SECRET=
ARGUS_NEWS_NAVER_BASE_URL=https://openapi.naver.com
ARGUS_NEWS_NAVER_SEARCH_PATH=/v1/search/news.json
ARGUS_NEWS_NAVER_DISPLAY=20
ARGUS_NEWS_NAVER_PAGE_LIMIT=2

ARGUS_DISCLOSURE_DART_API_KEY=
ARGUS_DISCLOSURE_DART_BASE_URL=https://opendart.fss.or.kr
ARGUS_DISCLOSURE_DART_LIST_PATH=/api/list.json
ARGUS_DISCLOSURE_DART_CORP_CLS=Y,K
ARGUS_DISCLOSURE_DART_PBLNTF_TY=B,I
ARGUS_DISCLOSURE_DART_LOOKBACK_DAYS=1
ARGUS_DISCLOSURE_DART_PAGE_COUNT=50
