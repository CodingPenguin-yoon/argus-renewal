# Example cron entries for KRX normalized event pipeline
# Install: crontab -e, then paste and adjust paths/env

# Every 15 minutes: normalize newly ingested raw documents into events
*/15 * * * * cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli normalize-events --limit 200 >> ../doc/event-pipeline.log 2>&1'

# Every hour: snapshot pending review queue for operators
5 * * * * cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli list-event-review-queue --limit 200 --status PENDING >> ../doc/event-review-queue.log 2>&1'
