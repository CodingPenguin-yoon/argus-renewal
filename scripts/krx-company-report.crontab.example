# Example cron entries for KRX company report pipeline
# Install: crontab -e, then paste and adjust paths/env

# Weekdays 18:40 KST: nightly universe report generation
40 18 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli generate-company-reports-nightly --universe-key KRX_LARGE_CAP_CORE >> ../doc/company-report.log 2>&1'

# Weekdays 19:10 KST: rerun failed subset only
10 19 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli rerun-failed-company-reports --universe-key KRX_LARGE_CAP_CORE >> ../doc/company-report.log 2>&1'
