# Example cron entries for KRX pre-market briefing input collectors
# Install: crontab -e, then paste and adjust paths/env

# Weekdays 06:40 KST: night-session futures snapshot
40 6 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli collect-briefing-night >> ../doc/market-briefing.log 2>&1'

# Weekdays 08:20 KST: pre-open derivatives snapshot (for 08:30 briefing)
20 8 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli collect-briefing-preopen >> ../doc/market-briefing.log 2>&1'

# Weekdays 08:30 KST: deterministic market briefing generation
30 8 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli generate-market-briefing --mode SCHEDULED >> ../doc/market-briefing.log 2>&1'

# Weekdays 16:10 KST: end-of-day factor collection
10 16 * * 1-5 cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli collect-briefing-eod >> ../doc/market-briefing.log 2>&1'
