# Example cron entries for KRX raw source ingestion
# Install: crontab -e, then paste and adjust paths/env

# Every minute: session-aware news automation.
# The command runs every tick during KRX session, slows to 5 minutes after close, and 10 minutes off-hours/weekends.
* * * * * cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli run-news-automation >> ../doc/raw-ingestion.log 2>&1'

# Nightly backfill safety window for last 2 days (optional)
10 2 * * * cd /Users/yoon/03_projects/05_economy_project/argus_renewal/backend && \
  /usr/bin/env bash -lc 'set -a; [ -f ../.env ] && source ../.env; set +a; python3 -m src.krx.source_ingestion.cli sync-dart --days 2 --backfill >> ../doc/raw-ingestion.log 2>&1'
